{
  "name": "layer-lens",
  "displayName": "Layer Lens",
  "description": "Filter the folder tree by layers (application, domain, infrastructure) in projects organized by contexts.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/{application,domain,infrastructure}"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "layerLens.tree",
          "name": "Layer Lens"
        }
      ]
    },
    "commands": [
      {
        "command": "layerLens.pickLayers",
        "title": "Pick layers…",
        "icon": "$(filter)",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.showAll",
        "title": "Show all layers",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.toggleOthers",
        "title": "Toggle other folders and files",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.toggleFlatten",
        "title": "Flatten layer folder (only with a single active layer)",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.newFile",
        "title": "New file",
        "icon": "$(new-file)",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.newFolder",
        "title": "New folder",
        "icon": "$(new-folder)",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.editLayers",
        "title": "Edit layers…",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.editColor",
        "title": "Change layer color…",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.rescan",
        "title": "Rescan layers",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.reveal",
        "title": "Reveal in Explorer",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.copyRelativePath",
        "title": "Copy relative path",
        "category": "Layer Lens"
      },
      {
        "command": "layerLens.soloLayer",
        "title": "Show only this layer",
        "category": "Layer Lens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "layerLens.pickLayers",
          "when": "view == layerLens.tree",
          "group": "navigation@3"
        },
        {
          "command": "layerLens.refresh",
          "when": "view == layerLens.tree",
          "group": "navigation@4"
        },
        {
          "command": "layerLens.showAll",
          "when": "view == layerLens.tree",
          "group": "1_filter@1"
        },
        {
          "command": "layerLens.toggleOthers",
          "when": "view == layerLens.tree",
          "group": "1_filter@2"
        },
        {
          "command": "layerLens.toggleFlatten",
          "when": "view == layerLens.tree",
          "group": "1_filter@3"
        },
        {
          "command": "layerLens.newFile",
          "when": "view == layerLens.tree",
          "group": "navigation@1"
        },
        {
          "command": "layerLens.newFolder",
          "when": "view == layerLens.tree",
          "group": "navigation@2"
        },
        {
          "command": "layerLens.editLayers",
          "when": "view == layerLens.tree",
          "group": "2_layers@2"
        },
        {
          "command": "layerLens.rescan",
          "when": "view == layerLens.tree",
          "group": "2_layers@4"
        },
        {
          "command": "layerLens.editColor",
          "when": "view == layerLens.tree",
          "group": "2_layers@3"
        }
      ],
      "webview/context": [
        {
          "command": "layerLens.newFile",
          "when": "webviewId == 'layerLens.tree' && webviewSection =~ /^(dir|file|root)$/",
          "group": "1_create@1"
        },
        {
          "command": "layerLens.newFolder",
          "when": "webviewId == 'layerLens.tree' && webviewSection =~ /^(dir|file|root)$/",
          "group": "1_create@2"
        },
        {
          "command": "layerLens.reveal",
          "when": "webviewId == 'layerLens.tree' && webviewSection =~ /^(dir|file)$/",
          "group": "2_files@1"
        },
        {
          "command": "layerLens.copyRelativePath",
          "when": "webviewId == 'layerLens.tree' && webviewSection =~ /^(dir|file)$/",
          "group": "2_files@2"
        },
        {
          "command": "layerLens.soloLayer",
          "when": "webviewId == 'layerLens.tree' && webviewSection == layer",
          "group": "1_layer@0"
        },
        {
          "command": "layerLens.editColor",
          "when": "webviewId == 'layerLens.tree' && webviewSection == layer",
          "group": "1_layer@1"
        }
      ],
      "commandPalette": [
        {
          "command": "layerLens.reveal",
          "when": "false"
        },
        {
          "command": "layerLens.copyRelativePath",
          "when": "false"
        },
        {
          "command": "layerLens.soloLayer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Layer Lens",
      "properties": {
        "layerLens.layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "application",
            "domain",
            "infrastructure"
          ],
          "description": "Folder names (case-insensitive) always treated as layers, in addition to the ones detected or added by hand."
        },
        "layerLens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "dist",
            "build",
            "out",
            ".git",
            "coverage",
            ".next",
            ".turbo"
          ],
          "description": "Folder/file names that are never shown."
        },
        "layerLens.flattenLayerFolder": {
          "type": "boolean",
          "default": false,
          "description": "With a single active layer, omit the layer node and list its files directly under the context."
        },
        "layerLens.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "The first time a workspace is opened, scan it for folder names repeated across sibling folders (e.g. contexts/*/application) and ask which ones to treat as layers. \"Layer Lens: rescan layers\" can be run at any time."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
